{
    "keyboard_name": "Little Big Scroll 4",
    "manufacturer": "Tweetys Wild Thinking",
    "url": "https://lectronz.com/stores/tweetys-wild-thinking",
    "maintainer": "TweetyDaBird",
    "bootloader": "rp2040",
    "processor": "RP2040",
    "usb": {
        "vid": "0xFEED",
        "pid": "0x23B0",
        "device_version": "2.0.0"
    },
    "matrix_pins": {
        "direct": [
            ["GP28", "GP29", "GP3"],
            ["GP15", "GP14", null]
        ]
    },
    "encoder": {
        "rotary": [
            {"pin_a": "GP6", "pin_b": "GP5", "resolution": 2}
        ]
    },
    "rgblight": {
        "led_count": 6,
        "max_brightness": 175,
        "animations": {
            "alternating": true,
            "breathing": true,
            "rainbow_mood": true,
            "static_gradient": true
        }
    },
    "ws2812": {
        "pin": "GP27"
    },
    "layouts": {
        "LAYOUT": {
            "layout": [
                {"label": "Play", "matrix": [0, 2], "x": 2, "y": 0, "w": 2, "h": 2},
                {"label": "F1", "matrix": [0, 0], "x": 0, "y": 0},
                {"label": "F2", "matrix": [0, 1], "x": 1, "y": 0},
                {"label": "F3", "matrix": [1, 0], "x": 0, "y": 1},
                {"label": "F4", "matrix": [1, 1], "x": 1, "y": 1}
            ]
        }
    }
}
